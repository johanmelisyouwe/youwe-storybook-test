{
    "name": "youwe-storybook-test",
    "version": "0.1.0",
    "private": true,
    "description": "Youwe design system in Storybook (Next.js + React). Figma is the source of truth.",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "tokens": "node scripts/build-tokens.mjs tokens/figma-variables.json src/tokens",
        "storybook": "pnpm tokens && storybook dev -p 6006",
        "build-storybook": "pnpm tokens && storybook build -o storybook-static",
        "typecheck": "tsc --noEmit",
        "check": "node scripts/check-legacy.mjs && node scripts/check-coverage.mjs",
        "lint": "biome check .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "next": "16.4.5",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.6",
        "@storybook/addon-a11y": "10.6.5",
        "@storybook/addon-docs": "10.6.5",
        "@storybook/nextjs-vite": "10.6.5",
        "@types/node": "^22",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "storybook": "10.6.5",
        "storybook-addon-pseudo-states": "^10.6.5",
        "typescript": "^5",
        "vite": "^7"
    },
    "engines": {
        "node": ">=20.19"
    },
    "packageManager": "pnpm@10.33.2",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
